# Copy this file to .env for local development. Never commit .env.
SECRET_KEY=replace-with-a-long-random-value
SECRET_KEY_FALLBACKS=
DEBUG=False
ALLOWED_HOSTS=your-app.example.com
# Leave empty to use SQLite locally. In production, inject the complete URL
# from the hosting provider or secret manager; never commit the password.
DATABASE_URL=
TIME_ZONE=Asia/Dubai
